{
  "name": "@agentic-hub/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve -p server web --parallel=2",
    "test": "nx run-many -t test --watch=false",
    "lint": "nx run-many -t lint",
    "build": "nx run-many -t build",
    "docs:dev": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:preview": "bun run --cwd apps/docs preview",
    "publish:local": "bun run build && bun link",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "ah": "node apps/cli/dist/main.js"
  },
  "private": true,
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@fission-ai/openspec": "1.16.0",
    "@nx/esbuild": "24.0.3",
    "@nx/eslint": "24.0.3",
    "@nx/eslint-plugin": "24.0.3",
    "@nx/js": "24.0.3",
    "@nx/node": "24.0.3",
    "@nx/react": "24.0.3",
    "@nx/vite": "24.0.3",
    "@nx/vitest": "24.0.3",
    "@nx/web": "24.0.3",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "nx": "24.0.3",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "type": "module",
  "bin": {
    "ah": "apps/cli/dist/main.js"
  },
  "engines": {
    "node": ">=26"
  },
  "trustedDependencies": []
}
